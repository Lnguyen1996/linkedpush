# ============================================
# LinkedPush API — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================

# Database (PostgreSQL)
# Example: Host=localhost;Port=5432;Database=linkedpush_dev;Username=myuser;Password=mypassword
DATABASE_URL=

# Session signing key — generate with: openssl rand -hex 32
# Must be at least 32 characters. Change this in production!
SECRET_KEY=

# LinkedIn OAuth2 credentials (for LinkedIn posting / connect flow)
# Register your app at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Redirect URI accepts the generic /api/auth/callback path shared with Google —
# the backend dispatches to the LinkedIn handler based on the OAuth state row's
# Provider column, so both /api/auth/callback and /api/auth/linkedin/callback
# work. Set this to match the "Authorized redirect URL" in your LinkedIn
# Developer Portal app (it only allows a single URI).
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Google OAuth2 credentials (primary login provider)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Anthropic API key for AI post generation
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Optional: restrict session cookies to a specific domain (e.g., .linkedpush.com)
# COOKIE_DOMAIN=

# Optional: enable/disable dev mode (never enable in production!)
DEV_MODE=true

# Optional: R2/S3-compatible storage for media files
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub.yourdomain.com
